---
interface Props {
  href: string;
  title: string;
  outcomeHeadline: string;
  image: string;
  tags: string[];
  cta?: string;
}

import { withBase } from '../lib/base';

const { href, outcomeHeadline, image, tags, cta = 'Read the story →' } = Astro.props;
const src = withBase(image);
---

<a class="project-card" href={href}>
  <img src={src} alt="" />
  <div class="project-meta">
    {tags.map((tag) => <span>{tag}</span>)}
  </div>
  <h2>{outcomeHeadline}</h2>
  <span class="cta">{cta}</span>
</a>
