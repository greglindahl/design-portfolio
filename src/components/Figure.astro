---
interface Props {
  src: string;
  alt?: string;
  caption?: string;
  narrow?: boolean;
}

import { withBase } from '../lib/base';

const { src, alt = '', caption, narrow = false } = Astro.props;
const url = withBase(src);
---

<figure class:list={['figure', { 'figure-narrow': narrow }]}>
  <img src={url} alt={alt} loading="lazy" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>
